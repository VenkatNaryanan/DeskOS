# ==============================================================================
# DeskOS — Environment Configuration Template
# Copy this file to .env and provide your actual service credentials.
# NEVER commit your populated .env file to version control.
# ==============================================================================

# Meta WhatsApp Cloud API (https://developers.facebook.com)
META_ACCESS_TOKEN="YOUR_META_PERMANENT_OR_SYSTEM_USER_ACCESS_TOKEN"
META_PHONE_NUMBER_ID="YOUR_WHATSAPP_BUSINESS_PHONE_NUMBER_ID"
META_APP_SECRET="YOUR_META_APP_SECRET_FOR_HMAC_VALIDATION"
META_VERIFY_TOKEN="YOUR_CUSTOM_WEBHOOK_VERIFY_TOKEN"

# Groq Cloud (Ultra-Fast LPUs: https://console.groq.com)
GROQ_API_KEY="gsk_YOUR_GROQ_API_KEY"
GROQ_CHAT_MODEL="llama-3.3-70b-versatile"

# Supabase PostgreSQL & Auth (https://supabase.com)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# DeskOS Server & Security
PORT=8000
DEV_MODE="true"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
