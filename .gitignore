# ==============================================================================
# DeskOS — Git Ignore Rules
# Excludes sensitive credentials, virtual environments, binaries, and dependencies
# ==============================================================================

# Environment variables & secrets (NEVER commit secrets!)
.env
.env*.local
.env.production
.env.development
*.pem
*.key
*.cert

# Allow environment template
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
backend/venv/

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Database files & local stores
*.db
*.sqlite
*.sqlite3
backend/data/*.db
backend/data/*.sqlite
!backend/data/.gitkeep

# Node & Next.js
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
frontend/build/
.pnp
.pnp.*
*.tsbuildinfo

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and IDE files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
